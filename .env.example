# Optional: configure a default model on the server.
# If set, visitors don't need to enter their own API key in the browser.
# Supported providers: deepseek | openai | anthropic | custom
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Maximum characters of paper context sent with each question (default 46000)
MAX_CONTEXT_CHARS=46000

# Server port (default 8787)
PORT=8787
