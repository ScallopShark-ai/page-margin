# Optional: configure a default model on the server.
# If set, visitors don't need to enter their own API key in the browser.
# Supported providers: deepseek | openai | anthropic | custom
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Maximum characters of paper context sent with each question (default 46000)
MAX_CONTEXT_CHARS=46000

# Server port (default 8787)
PORT=8787

# Optional: local HTTP proxy for model requests.
# Windows browser/system proxy settings are not inherited by Node.js.
# `npm start` loads this file before starting the server; Node 24+ is required
# for automatic environment-proxy support.
# HTTPS_PROXY=http://127.0.0.1:6518
# HTTP_PROXY=http://127.0.0.1:6518
# NO_PROXY=localhost,127.0.0.1,::1
