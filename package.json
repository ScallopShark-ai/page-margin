{
  "name": "page-margin",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "海拉 — a paper reading workspace with an AI margin companion",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.mjs",
    "preview": "vite preview",
    "setup:pdf2zh": "node scripts/setup-pdf2zh.mjs",
    "deploy": "node scripts/deploy.mjs",
    "upgrade": "node scripts/upgrade.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
